# NeelKIT configuration.
#
# Copy to .env and edit. Every value here has a working default; nothing in this
# file is required to start. Names map one-to-one to the settings in
# internal/config, and a flag on the command line always beats the environment.

# ---------------------------------------------------------------- server
# Loopback by default. Binding wider than this exposes a service that can run
# programs on your machine, so it is deliberately not the default.
NEELKIT_HTTP_ADDR=127.0.0.1:8420

# Browser origins allowed to call the API. "*" is refused while authentication
# is on: this API carries a bearer token and can execute commands.
NEELKIT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------ auth
# The key neelkitd prints on its first run. Leave it unset and a new one is
# generated (and printed) on every start. There is no "no authentication" mode.
# NEELKIT_API_KEY=nk_xxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------- speech
NEELKIT_MODELS_DIR=./models
# Where libonnxruntime lives, if it is not in a standard location.
# NEELKIT_ORT_LIBRARY=/opt/onnxruntime/lib/libonnxruntime.so

# cpu or cuda. An unavailable GPU fails at startup rather than silently
# falling back: a GPU machine quietly running CPU inference is the worst
# failure mode available.
NEELKIT_ASR_DEVICE=cpu
# NEELKIT_ASR_GPU_DEVICE=0

# Concurrent decoder workers. Each holds its own ONNX session. More than about
# half your cores makes latency worse, because the encoder then competes with
# them for the same threads.
NEELKIT_ASR_WORKERS=2

# --------------------------------------------------------------- realtime
NEELKIT_PARTIALS=true
# Silence before an utterance is considered finished. The single biggest lever
# on how responsive the assistant feels: too short truncates a thinking pause,
# too long feels sluggish.
NEELKIT_HANGOVER_MS=600
NEELKIT_PARTIAL_EVERY=400ms
NEELKIT_MAX_UTTERANCE=30s

# ----------------------------------------------------------- language model
# ollama, or none. With "none" the built-in commands still work; only the
# conversational long tail is unavailable.
NEELKIT_LLM_PROVIDER=ollama
NEELKIT_LLM_BASE_URL=http://127.0.0.1:11434
NEELKIT_LLM_MODEL=qwen2.5:7b-instruct
NEELKIT_LLM_TIMEOUT=60s

# ----------------------------------------------------------------- tools
# The only directory tools can reach. Point it at one project, not your home
# directory: this is the blast radius.
NEELKIT_WORKSPACE_ROOT=/home/you/dev/your-project

# Refuse every write and execute tool. A safe mode for screen shares and demos.
NEELKIT_WORKSPACE_READ_ONLY=false

NEELKIT_TOOL_TIMEOUT=30s
NEELKIT_TOOL_CONCURRENCY=2

# Binaries the shell tool may run. Leave unset for the built-in list.
# NEELKIT_ALLOWED_BINARIES=git,go,npm,make,rg,jq

# ---------------------------------------------------------------- storage
NEELKIT_DATA_DIR=./data

# ---------------------------------------------------------- observability
NEELKIT_LOG_LEVEL=info
NEELKIT_LOG_FORMAT=json
# Serve /metrics without a key. Only sensible behind a private network.
NEELKIT_METRICS_PUBLIC=false

# ------------------------------------------------------------------- web
# Where the browser should reach the API. Baked into the bundle at build time;
# it is a URL, not a secret.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8420
